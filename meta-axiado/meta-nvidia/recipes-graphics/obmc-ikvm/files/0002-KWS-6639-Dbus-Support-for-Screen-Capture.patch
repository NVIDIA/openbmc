+void Video::writeFile(const std::string& filePath)
+{
+    if (lastFrameIndex < 0 || buffers[lastFrameIndex].data == nullptr)
+    {
+        return;
+    }
+
+    const size_t width = 640;
+    const size_t height = 480;
+    const size_t bytesPerPixel = 4; // RGB888: R, G, B, unused padding
+
+    FILE* fp = fopen(filePath.c_str(), "wb");
+    if (!fp)
+    {
+        return;
+    }
+
+    png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+    if (!png)
+    {
+        fclose(fp);
+        return;
+    }
+
+    png_infop info = png_create_info_struct(png);
+    if (!info)
+    {
+        png_destroy_write_struct(&png, nullptr);
+        fclose(fp);
+        return;
+    }
+
+    if (setjmp(png_jmpbuf(png)))
+    {
+        png_destroy_write_struct(&png, &info);
+        fclose(fp);
+        return;
+    }
+
+    png_init_io(png, fp);
+
+    png_set_IHDR(
+        png,
+        info,
+        width,
+        height,
+        8,
+        PNG_COLOR_TYPE_RGB, // Not RGBA
+        PNG_INTERLACE_NONE,
+        PNG_COMPRESSION_TYPE_DEFAULT,
+        PNG_FILTER_TYPE_DEFAULT);
+
+    png_write_info(png, info);
+
+    const uint8_t* data = static_cast<const uint8_t*>(buffers[lastFrameIndex].data);
+    for (size_t y = 0; y < height; ++y)
+    {
+        static std::vector<uint8_t> row;
+        row.resize(width * 3);
+        for (size_t x = 0; x < width; ++x)
+        {
+            size_t idx = (y * width + x) * bytesPerPixel;
+            row[x * 3 + 0] = data[idx + 0]; // R
+            row[x * 3 + 1] = data[idx + 1]; // G
+            row[x * 3 + 2] = data[idx + 2]; // B
+        }
+        png_write_row(png, row.data());
+    }
+
+    png_write_end(png, nullptr);
+    png_destroy_write_struct(&png, &info);
+    fclose(fp);
+}
