MACHINE ??= "gb200nvl-bmc-axiado"
DISTRO ?= "openbmc-phosphor"
DISTRO_VERSION:append = ".${@time.time()}"
PACKAGE_CLASSES ?= "package_rpm"
SANITY_TESTED_DISTROS:append ?= " *"
EXTRA_IMAGE_FEATURES = "allow-empty-password allow-root-login empty-root-password post-install-logging"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS = "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"
INHERIT += "extrausers"
EXTRA_USERS_PARAMS = " \
  usermod -p '\$1\$UGMqyqdG\$FZiylVFmRRfl9Z0Ue8G7e/' root; \
  "

include conf/password-policy.inc
require conf/distro.inc

SSTATE_DIR = "${TOPDIR}/../sstate-cache"
DL_DIR = "${TOPDIR}/../downloads"

# Build var, valid values are ["dbg", "dev", "prod"]
# Dbg builds initramfs image with filesystem + kernel in a single image and u-boot
# Dev builds kernel-fitImage and eMMC image with wic filesystem and u-boot
# Prod builds kernel-fitImage and eMMC image with wic filesystem and Axiado-signed u-boot
#BUILD_VAR = "dbg"
