index 5c7cb10..5ea1df0 100644
--- a/services/meson.build
+++ b/services/meson.build
@@ -147,6 +147,21 @@ if get_option('MTD_UPDATER_SUPPORT').enabled()
     )
 endif
 
+if get_option('AXIADO_UPDATER_SUPPORT').enabled()
+
+    unit_files = unit_files + ['scm-update@.service']
+
+    bmc_model = get_option('BMC_SUPPORTED_MODEL')
+
+    if (bmc_model != '')
+        unit_files = unit_files + ['com.Axiado.SCM.Updater.bmc.service']
+        bmc_sed_arg = 's/BMC_MODEL/'
+        bmc_sed_arg +=bmc_model
+        bmc_sed_arg += '/g'
+        run_command('sed', '-i', bmc_sed_arg, 'com.Axiado.SCM.Updater.bmc.service', check: true)
+    endif
+endif
+
 if get_option('SWITCHTEC_FUSE_SUPPORT').enabled()
     unit_files = unit_files + [
         'com.Nvidia.Switchtec.Fuse.service',
diff --git a/services/scm-update@.service b/services/scm-update@.service
new file mode 100644
index 0000000..bf04e98
--- /dev/null
+++ b/services/scm-update@.service
@@ -0,0 +1,9 @@
+[Unit]
+Description=Update Axiado BMC
+
+[Service]
+Type=oneshot
+RemainAfterExit=no
+Environment="ARGS=%I"
+ExecStart=scm-update.sh $ARGS
+
