		i2c27 = &imux27;
		i2c28 = &imux28;
		i2c29 = &imux29;
		i2c30 = &imux30;
		i2c31 = &imux31;
		i2c32 = &imux32;
		i2c33 = &imux33;
		i2c34 = &imux34;
		i2c35 = &imux35;
		i2c36 = &imux36;
		i2c37 = &imux37;
		i2c38 = &imux38;
		i2c39 = &imux39;
		i2c40 = &imux40;
		i2c41 = &imux41;
		i2c42 = &imux42;
		i2c43 = &imux43;
		i2c44 = &imux44;
		i2c45 = &imux45;
		i2c46 = &imux46;
		i2c47 = &imux47;
		i2c48 = &imux48;
		i2c49 = &imux49;
		i2c50 = &imux50;
		i2c51 = &imux51;
		i2c52 = &imux52;
		i2c53 = &imux53;
		i2c54 = &imux54;
		i2c55 = &imux55;
		i2c56 = &imux56;
		i2c57 = &imux57;
		i2c58 = &imux58;
		i2c59 = &imux59;
	};
	leds {
		compatible = "gpio-leds";
		uid_led {
			gpios = <&mfd_sgpio0 114 GPIO_ACTIVE_LOW>;
		};
		fault_led {
			gpios = <&mfd_sgpio0 113 GPIO_ACTIVE_LOW>;
		};
		power_led {
			gpios = <&mfd_sgpio0 112 GPIO_ACTIVE_LOW>;
		};

		// Non-LEDs:
		//   BMC_READY-O GPIO pin (not an LED) is being bound to the GPIO LED driver.
		// Notes:
		// * This is a workaround and leverages the GPIO LED driver to enable control of
		//   reset tolerance and still allow the GPIO to be controlled from user space.
		// * The standard Linux GPIO driver allows control of reset tolerance, however
		//   does not expose user space APIs for user space control of the GPIO pin.
		// * GPIO_TRANSITORY = reset tolerance is disabled
		// * Any non-leds should be added below this line.
		bmc_ready_noled {
			gpios = <&gpio3 17 (GPIO_ACTIVE_HIGH|GPIO_TRANSITORY)>;
		};
	};
	buttons {
		power-btn {
			gpio = <&mfd_sgpio0 202 GPIO_ACTIVE_LOW>;
		};
		uid-btn {
			gpio = <&mfd_sgpio0 203 GPIO_ACTIVE_LOW>;
		};
	};
};

