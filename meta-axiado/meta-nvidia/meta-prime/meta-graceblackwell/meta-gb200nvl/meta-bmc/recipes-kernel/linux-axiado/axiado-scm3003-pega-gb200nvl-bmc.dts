/dts-v1/;

#include "ax3000-scm3003.dtsi"
#include "ax3000-net-mod.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Axiado AX3000-SCM3003 - PEGA GB200NVL BMC";
	aliases {
		i2c0 = &i3c0;
		i2c1 = &i3c1;
		i2c2 = &mfd_i2c6;
		i2c3 = &i3c16;
		i2c4 = &i3c8;
		i2c5 = &mfd_i2c2;
		i2c6 = &mfd_i2c3;
		i2c7 = &i3c3;
		i2c8 = &i3c15;
		i2c9 = &i3c11;
		i2c10 = &i3c7;
		i2c11 = &i3c5;
		i2c12 = &i3c12;
		i2c13 = &i3c13;
		i2c14 = &i3c6;
		i2c15 = &i3c4;
		i2c16 = &imux16;
		i2c17 = &imux17;
		i2c18 = &imux18;
		i2c19 = &imux19;
		i2c20 = &imux20;
		i2c21 = &imux21;
