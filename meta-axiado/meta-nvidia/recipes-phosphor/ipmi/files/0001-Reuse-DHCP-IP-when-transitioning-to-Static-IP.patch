diff --git a/transporthandler.cpp b/transporthandler.cpp
index d49c94c..18f23af 100644
--- a/transporthandler.cpp
+++ b/transporthandler.cpp
@@ -842,6 +842,8 @@ RspType<> setLanInt(Context::ptr ctx, uint4_t channelBits, uint4_t reserved1,
                     return responseInvalidFieldRequest();
                 case IPSrc::Static:
                     channelCall<setEthProp<bool>>(channel, "DHCP4", false);
+                    channelCall<reconfigureIfAddr4>(channel, std::nullopt,
+                                                    std::nullopt);
                     return responseSuccess();
                 case IPSrc::BIOS:
                 case IPSrc::BMC:
